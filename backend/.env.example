# ==============================================================
# ASHA SAATHI Community Health Management System - Environment Example
# ==============================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection URI
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/asha_db

# Cloud MongoDB (Atlas):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/asha_db?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# File Uploads Directory
UPLOAD_DIR=uploads
